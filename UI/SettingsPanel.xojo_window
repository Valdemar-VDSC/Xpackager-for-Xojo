#tag EndDesktopWindow

#tag WindowCode
	#tag Method, Flags = &h21
		Private Sub ApplyTexts()
		  mUpdating = True
		  // ProductHeader.Text = Loc.kProduct
		  PackageNameLabel.Text = Loc.kPackageName
		  PackageNameField.Tooltip = Loc.kPackageNameHelp
		  InfoButton.Tooltip = Loc.kDynamicTokensHelp
		  If InfoButton.Inner <> Nil Then InfoButton.Inner.SetBordered(False)
		  WebSafeCheckLabel.Text = Loc.kWebSafeToggle
		  NameHelp.Text = Loc.kPerComponentNote
		  // SignatureHeader.Text = Loc.kSignatureOptional
		  SigningLabel.Text = Loc.kSigningIdentity
		  RefreshButton.Tooltip = Loc.kRefreshIdentities
		  If RefreshButton.Inner <> Nil Then RefreshButton.Inner.SetBordered(False)
		  // HardenHeader.Text = Loc.kHardeningSection
		  HardenCheckLabel.Text = Loc.kHardenToggle
		  AppIdentityLabel.Text = Loc.kAppIdentityLabel
		  HardenHelp.Text = Loc.kHardenHelp
		  // NotarizeHeader.Text = Loc.kNotarizationOptional
		  NotarizeCheckLabel.Text = Loc.kNotarizeAfterBuild
		  
		  EnsureTokenMenu
		  mUpdating = False
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub EnsureIdentityMenus()
		  // Picker d'un Form groupé SwiftUI : un menu sans bordure, titre et chevron,
		  // calé à droite de sa ligne — et non la capsule grise d'un popup encadré.
		  If mSigningPopup <> Nil Then Return
		  Declare Sub setBordered Lib "AppKit" Selector "setBordered:" (v As Ptr, flag As Boolean)
		  mSigningPopup = New NativePopupButton(False)
		  setBordered(mSigningPopup.Handle, False)
		  AddHandler mSigningPopup.Changed, AddressOf SigningChosen
		  NativeControlHost.Fill(SigningHost, mSigningPopup.Handle)
		  
		  mAppIdentityPopup = New NativePopupButton(False)
		  setBordered(mAppIdentityPopup.Handle, False)
		  AddHandler mAppIdentityPopup.Changed, AddressOf AppIdentityChosen
		  NativeControlHost.Fill(AppIdentityHost, mAppIdentityPopup.Handle)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub RightAlign(host As DesktopCanvas, pop As NativePopupButton)
		  // Un Picker de Form groupé se pose à droite de sa ligne, à sa largeur propre.
		  If host Is Nil Or pop Is Nil Then Return
		  Declare Sub sizeToFit Lib "AppKit" Selector "sizeToFit" (v As Ptr)
		  Var h As Ptr = pop.Handle
		  If h = Nil Then Return
		  sizeToFit(h)
		  Var r As Cocoa.NSRect = Cocoa.ViewFrame(h)
		  Var hf As Cocoa.NSRect = Cocoa.ViewFrame(host.Handle)
		  // sizeToFit dimensionne sur l'item le plus long du menu : on s'en tient au
		  // titre affiché, plus la zone du chevron.
		  Var p As New Picture(4, 4)
		  p.Graphics.FontName = "System"
		  p.Graphics.FontSize = 13
		  r.width = Min(Ceiling(p.Graphics.TextWidth(pop.SelectedTitle) + 34), hf.width)
		  r.x = hf.width - r.width
		  r.y = Round((hf.height - r.height) / 2)
		  Cocoa.SetViewFrame(h, r)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub SigningChosen(sender As NativePopupButton, index As Integer)
		  #Pragma Unused sender
		  If mUpdating Or mProject Is Nil Then Return
		  If index < 0 Or index > mSigningTags.LastIndex Then Return
		  mProject.Settings.SigningIdentity = mSigningTags(index)
		  Touch
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub AppIdentityChosen(sender As NativePopupButton, index As Integer)
		  #Pragma Unused sender
		  If mUpdating Or mProject Is Nil Then Return
		  If index < 0 Or index > mAppTags.LastIndex Then Return
		  mProject.Settings.AppSigningIdentity = mAppTags(index)
		  Touch
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub EnsureTokenMenu()
		  // Menu { variables } label: { Label("Insérer une variable", systemImage: "curlybraces") }
		  //   .menuStyle(.borderlessButton).fixedSize() — calé à gauche, à sa largeur.
		  // Remplace un NativeComboButtonControl dont MenuItemSelected tombait, dans
		  // VDSTools 1.1, sur le créneau de Paint : le choix n'arrivait jamais.
		  If mTokenPopup <> Nil Then Return
		  Var entries() As String
		  For Each token As String In PackageNaming.TokenNames
		    entries.Add("$(" + token + ") — " + TokenDescription(token))
		  Next
		  Var w As Double
		  mTokenPopup = XPUI.MakePullDown(Loc.kInsertVariable, "curlybraces", entries, w)
		  AddHandler mTokenPopup.Changed, AddressOf TokenChosen
		  NativeControlHost.Fill(TokenHost, mTokenPopup.Handle)
		  // calé à gauche du canevas, à la largeur de son titre
		  Var r As Cocoa.NSRect = Cocoa.ViewFrame(mTokenPopup.Handle)
		  r.x = 0
		  r.width = Min(w, TokenHost.Width)
		  Cocoa.SetViewFrame(mTokenPopup.Handle, r)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub FillIdentityMenu(pop As NativePopupButton, tags() As String, names() As String, current As String, emptyTitle As String)
		  // NSPopUpButton sans bordure : pas de RowTag, on garde les identités à côté,
		  // dans le même ordre que les items.
		  If pop Is Nil Then Return
		  pop.RemoveAllItems
		  tags.RemoveAll
		  pop.AddItem(emptyTitle)
		  tags.Add("")
		  Var selected As Integer = 0
		  For Each name As String In names
		    pop.AddItem(name)
		    tags.Add(name)
		    If name = current Then selected = tags.LastIndex
		  Next
		  If current <> "" And selected = 0 Then
		    pop.AddItem(Loc.kUnavailable.ReplaceAll("%@", current))
		    tags.Add(current)
		    selected = tags.LastIndex
		  End If
		  pop.SelectedIndex = selected
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub FitSwitches()
		  // Appelé par ProjectWindow une fois la page affichée : la bibliothèque
		  // héberge l'interrupteur au premier dessin et lui impose alors son cadre.
		  XPUI.FitSwitch(WebSafeCheck)
		  XPUI.FitSwitch(HardenCheck)
		  XPUI.FitSwitch(NotarizeCheck)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Icon(ByRef view As NativeImageView, shown As Boolean, symbolName As String, tint As Color, x As Double, top As Double, size As Double)
		  // Symbole SF d'une ligne (Label(…, systemImage:) en SwiftUI) : une NSImageView
		  // posée directement dans la vue du panneau, au-dessus des cadres de groupe.
		  If view Is Nil Then
		    If Not shown Then Return
		    view = New NativeImageView(size, size)
		    Cocoa.AddSubview(Self.Handle, view.Handle)
		  End If
		  XPUI.SetViewShown(view.Handle, shown)
		  If Not shown Then Return
		  view.SetTint(True, tint)
		  view.ShowSymbol(symbolName)
		  XPUI.PinView(Self.Handle, view.Handle, x, top, size, size)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub LayoutAll()
		  // Calque du Form(.grouped) SwiftUI : sections titrées, lignes séparées par des
		  // filets, et lignes qui n'existent que selon l'état — aperçu du nom, encadré
		  // d'aide au certificat, identité et aide du renforcement, aide et
		  // avertissement de la notarisation. Les sections grandissent et rétrécissent
		  // à la volée ; la disposition horizontale reste celle du markup.
		  //
		  // Deux temps : toutes les positions sont calculées (Q), puis appliquées —
		  // les cadres de groupe d'abord, leurs contenus ensuite, sans quoi redimensionner
		  // un groupe déplacerait ses enfants déjà posés.
		  If mProject Is Nil Then Return
		  Var pf As Cocoa.NSRect = Cocoa.ViewFrame(Self.Handle)
		  If pf.width <= 0 Or pf.height <= 0 Then Return
		  
		  Const kMargin = 20     // marge du formulaire
		  Const kInset = 10      // retrait du contenu dans le cadre (mesuré sur la version Swift)
		  Const kTitleH = 14     // titre de section au-dessus du cadre (mesuré)
		  Const kRowH = 37       // ligne de contrôle d'un Form groupé
		  Const kGap = 18        // entre deux sections
		  Var gx As Double = kMargin
		  Var gw As Double = pf.width - 2 * kMargin
		  Var cl As Double = gx + kInset
		  Var cr As Double = gx + gw - kInset
		  Var vc As Double = cl + 190   // colonne des valeurs
		  
		  mQC.RemoveAll
		  mQX.RemoveAll
		  mQY.RemoveAll
		  mQW.RemoveAll
		  mQH.RemoveAll
		  mRuleCount = 0
		  
		  Var y As Double = 20
		  Var top As Double
		  Var n As Integer
		  Var h As Double
		  
		  // ─── Produit ───
		  top = y
		  y = y + kTitleH
		  n = 0
		  Rule(n, NativeGroupBoxControl1, cl, cr, y)
		  Q(PackageNameLabel, cl, y + (kRowH - 18) / 2, vc - cl - 10, 18)
		  Q(PackageNameField, vc, y + (kRowH - 24) / 2, cr - vc, 24)
		  y = y + kRowH
		  
		  Rule(n, NativeGroupBoxControl1, cl, cr, y)
		  Q(TokenHost, cl, y + (kRowH - 24) / 2, TokenHost.Width, 24)
		  Q(InfoButton, cr - 30, y + (kRowH - 24) / 2, 30, 24)
		  y = y + kRowH
		  
		  Rule(n, NativeGroupBoxControl1, cl, cr, y)
		  Q(WebSafeCheckLabel, cl, y + (kRowH - 20) / 2, cr - cl - 52, 20)
		  Q(WebSafeCheck, cr - 40, y + (kRowH - 20) / 2, 40, 20)
		  y = y + kRowH
		  
		  Var showPreview As Boolean = PreviewLabel.Text <> ""
		  XPUI.SetShown(PreviewLabel, showPreview)
		  If showPreview Then
		    Rule(n, NativeGroupBoxControl1, cl, cr, y)
		    h = XPUI.TextHeight(PreviewLabel, PreviewLabel.Text, cr - cl)
		    Q(PreviewLabel, cl, y + 10, cr - cl, h)
		    y = y + h + 20
		  End If
		  
		  Rule(n, NativeGroupBoxControl1, cl, cr, y)
		  h = XPUI.TextHeight(NameHelp, NameHelp.Text, cr - cl)
		  Q(NameHelp, cl, y + 10, cr - cl, h)
		  y = y + h + 20
		  Q(NativeGroupBoxControl1, gx, top, gw, y - top)
		  y = y + kGap
		  
		  // ─── Signature ───
		  top = y
		  y = y + kTitleH
		  n = 0
		  Rule(n, NativeGroupBoxControl2, cl, cr, y)
		  Var lw As Double = Min(XPUI.FitLabelWidth(SigningLabel), cr - cl - 200)
		  Q(SigningLabel, cl, y + (kRowH - 18) / 2, lw, 18)
		  Q(SigningHost, cl + lw + 12, y + (kRowH - 22) / 2, cr - cl - lw - 12, 22)
		  y = y + kRowH
		  
		  // aide (ou avertissement « aucune identité ») à gauche, ↻ à droite
		  Rule(n, NativeGroupBoxControl2, cl, cr, y)
		  Var noIds As Boolean = mIdentities.Count = 0
		  Var tx As Double = cl
		  If noIds Then tx = cl + 20
		  h = XPUI.TextHeight(SigningHelp, SigningHelp.Text, cr - 40 - tx)
		  Var rowH As Double = Max(kRowH, h + 20)
		  Icon(mSigningIcon, noIds, "exclamationmark.triangle", &c8E8E93, cl, y + (rowH - 14) / 2, 14)
		  Q(SigningHelp, tx, y + (rowH - h) / 2, cr - 40 - tx, h)
		  Q(RefreshButton, cr - 32, y + (rowH - 24) / 2, 32, 24)
		  y = y + rowH
		  
		  // encadré d'aide au certificat : icône teintée, titre, message
		  Var showCert As Boolean = CertTitle.Text <> ""
		  XPUI.SetShown(CertTitle, showCert)
		  XPUI.SetShown(CertMessage, showCert)
		  If showCert Then
		    Rule(n, NativeGroupBoxControl2, cl, cr, y)
		    Var th As Double = XPUI.TextHeight(CertTitle, CertTitle.Text, cr - cl - 24)
		    Var mh As Double = XPUI.TextHeight(CertMessage, CertMessage.Text, cr - cl - 24)
		    Icon(mCertIcon, True, mCertSymbol, mCertTint, cl, y + 10, 16)
		    Q(CertTitle, cl + 24, y + 10, cr - cl - 24, th)
		    Q(CertMessage, cl + 24, y + 10 + th + 3, cr - cl - 24, mh)
		    y = y + th + 3 + mh + 20
		  Else
		    Icon(mCertIcon, False, "", &c000000, 0, 0, 16)
		  End If
		  Q(NativeGroupBoxControl2, gx, top, gw, y - top)
		  y = y + kGap
		  
		  // ─── Renforcement du payload ───
		  top = y
		  y = y + kTitleH
		  n = 0
		  Rule(n, NativeGroupBoxControl3, cl, cr, y)
		  Q(HardenCheckLabel, cl, y + (kRowH - 20) / 2, cr - cl - 52, 20)
		  Q(HardenCheck, cr - 40, y + (kRowH - 20) / 2, 40, 20)
		  y = y + kRowH
		  
		  Var harden As Boolean = mProject.Settings.HardenPayloadApps
		  Var hardenWarn As Boolean = harden And mAppIdentities.Count = 0
		  XPUI.SetShown(AppIdentityLabel, harden)
		  XPUI.SetShown(AppIdentityHost, harden)
		  XPUI.SetShown(HardenHelp, harden)
		  XPUI.SetShown(HardenWarnLabel, hardenWarn)
		  If harden Then
		    Rule(n, NativeGroupBoxControl3, cl, cr, y)
		    // Le libellé prend la place qu'il demande : à colonne fixe, « Identité
		    // (Developer ID Application) » était tronqué.
		    Var aw As Double = Min(XPUI.FitLabelWidth(AppIdentityLabel), cr - cl - 200)
		    Q(AppIdentityLabel, cl, y + (kRowH - 18) / 2, aw, 18)
		    Q(AppIdentityHost, cl + aw + 12, y + (kRowH - 22) / 2, cr - cl - aw - 12, 22)
		    y = y + kRowH
		    
		    Rule(n, NativeGroupBoxControl3, cl, cr, y)
		    h = XPUI.TextHeight(HardenHelp, HardenHelp.Text, cr - cl)
		    Q(HardenHelp, cl, y + 10, cr - cl, h)
		    y = y + h + 20
		  End If
		  If hardenWarn Then
		    Rule(n, NativeGroupBoxControl3, cl, cr, y)
		    h = XPUI.TextHeight(HardenWarnLabel, HardenWarnLabel.Text, cr - cl - 20)
		    Icon(mHardenIcon, True, "exclamationmark.triangle", &cFF9F0A, cl, y + 10, 14)
		    Q(HardenWarnLabel, cl + 20, y + 10, cr - cl - 20, h)
		    y = y + h + 20
		  Else
		    Icon(mHardenIcon, False, "", &c000000, 0, 0, 14)
		  End If
		  Q(NativeGroupBoxControl3, gx, top, gw, y - top)
		  y = y + kGap
		  
		  // ─── Notarisation ───
		  top = y
		  y = y + kTitleH
		  n = 0
		  Rule(n, NativeGroupBoxControl4, cl, cr, y)
		  Q(NotarizeCheckLabel, cl, y + (kRowH - 20) / 2, cr - cl - 52, 20)
		  Q(NotarizeCheck, cr - 40, y + (kRowH - 20) / 2, 40, 20)
		  y = y + kRowH
		  
		  Var notarize As Boolean = mProject.Notarization.Enabled
		  Var notarizeWarn As Boolean = notarize And mProject.Settings.SigningIdentity.Trim = ""
		  XPUI.SetShown(NotarizeHelp, notarize)
		  XPUI.SetShown(NotarizeWarnLabel, notarizeWarn)
		  If notarize Then
		    Rule(n, NativeGroupBoxControl4, cl, cr, y)
		    h = XPUI.TextHeight(NotarizeHelp, NotarizeHelp.Text, cr - cl)
		    Q(NotarizeHelp, cl, y + 10, cr - cl, h)
		    y = y + h + 20
		  End If
		  If notarizeWarn Then
		    Rule(n, NativeGroupBoxControl4, cl, cr, y)
		    h = XPUI.TextHeight(NotarizeWarnLabel, NotarizeWarnLabel.Text, cr - cl - 20)
		    Icon(mNotarizeIcon, True, "exclamationmark.triangle", &cFF9F0A, cl, y + 10, 14)
		    Q(NotarizeWarnLabel, cl + 20, y + 10, cr - cl - 20, h)
		    y = y + h + 20
		  Else
		    Icon(mNotarizeIcon, False, "", &c000000, 0, 0, 14)
		  End If
		  Q(NativeGroupBoxControl4, gx, top, gw, y - top)
		  
		  // ─── Application : groupes, puis contenus ───
		  For i As Integer = 0 To mQC.LastIndex
		    If mQC(i) IsA NativeGroupBoxControl Then XPUI.Place(Self.Handle, mQC(i), mQX(i), mQY(i), mQW(i), mQH(i))
		  Next
		  For i As Integer = 0 To mQC.LastIndex
		    If Not (mQC(i) IsA NativeGroupBoxControl) Then XPUI.Place(Self.Handle, mQC(i), mQX(i), mQY(i), mQW(i), mQH(i))
		  Next
		  // filets inutilisés masqués
		  For i As Integer = mRuleCount To mRules.LastIndex
		    XPUI.SetViewShown(mRules(i).Handle, False)
		  Next
		  // l'interrupteur hébergé suit son canevas redimensionné
		  FitSwitches
		  // les menus d'identité se calent à droite de leur canevas, à leur largeur
		  RightAlign(SigningHost, mSigningPopup)
		  RightAlign(AppIdentityHost, mAppIdentityPopup)
		  // le menu des variables reste calé à gauche de son canevas
		  If mTokenPopup <> Nil Then
		    Var r As Cocoa.NSRect = Cocoa.ViewFrame(mTokenPopup.Handle)
		    r.x = 0
		    Cocoa.SetViewFrame(mTokenPopup.Handle, r)
		  End If
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub LoadProject(p As PackageProject)
		  mProject = p
		  mIdentities = SigningIdentity.InstallerIdentities
		  mAppIdentities = SigningIdentity.ApplicationIdentities
		  ApplyTexts
		  Reload
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Q(c As DesktopUIControl, x As Double, top As Double, w As Double, h As Double)
		  // Met une pose en file ; LayoutAll les applique ensuite, groupes d'abord.
		  mQC.Add(c)
		  mQX.Add(x)
		  mQY.Add(top)
		  mQW.Add(w)
		  mQH.Add(h)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub Relayout()
		  // Appelé par ProjectWindow à chaque redimensionnement du volet de détail.
		  LayoutAll
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub Reload()
		  If mProject Is Nil Then Return
		  mUpdating = True
		  PackageNameField.Text = mProject.Settings.PackageName
		  WebSafeCheck.Value = mProject.Settings.WebSafeName
		  HardenCheck.Value = mProject.Settings.HardenPayloadApps
		  NotarizeCheck.Value = mProject.Notarization.Enabled
		  EnsureIdentityMenus
		  FillIdentityMenu(mSigningPopup, mSigningTags, mIdentities, mProject.Settings.SigningIdentity, Loc.kUnsigned)
		  FillIdentityMenu(mAppIdentityPopup, mAppTags, mAppIdentities, mProject.Settings.AppSigningIdentity, Loc.kChooseEllipsis)
		  mUpdating = False
		  UpdateHints
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Rule(ByRef n As Integer, group As DesktopUIControl, left As Double, right As Double, top As Double)
		  // Filet entre deux lignes d'une section, comme dans un Form groupé : rien avant
		  // la première ligne (n = 0), un filet avant chacune des suivantes.
		  n = n + 1
		  If n = 1 Then Return
		  If mRuleCount > mRules.LastIndex Then
		    mRules.Add(NativeBox.Separator(0, 0, right - left, 1))
		  End If
		  Var rule As NativeBox = mRules(mRuleCount)
		  // Sous-vue de SA section : autrement le filet reste à l'écran quand la page
		  // change, et ceux d'un onglet traînent sur les autres.
		  Cocoa.AddSubview(group.Handle, rule.Handle)
		  XPUI.SetViewShown(rule.Handle, True)
		  XPUI.PinView(Self.Handle, rule.Handle, left, top, right - left, 1)
		  mRuleCount = mRuleCount + 1
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub ShowTokenPopover()
		  // Liste des variables de texte dynamique, dans un NSPopover natif.
		  Var body() As String
		  body.Add(Loc.kSupportedDynamicText)
		  body.Add("")
		  For Each token As String In PackageNaming.TokenNames
		    body.Add("$(" + token + ")" + "   " + TokenDescription(token))
		  Next
		  body.Add("")
		  body.Add(Loc.kTokenValuesSource)
		  
		  mTokenText = New NativeTextView(380, 240)
		  mTokenText.Text = String.FromArray(body, EndOfLine)
		  mTokenText.SetEditable(False, False)
		  mTokenText.SetBorder(NativeTextView.Borders.None)
		  mTokenPopover = New NativePopover(400, 260)
		  mTokenPopover.AddView(mTokenText.Handle, 10, 10, 380, 240)
		  mTokenPopover.Show(InfoButton)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub TokenChosen(sender As NativePopupButton, index As Integer)
		  #Pragma Unused sender
		  If mUpdating Or mProject Is Nil Then Return
		  Var tokens() As String = PackageNaming.TokenNames
		  Var i As Integer = index - 1   // l'item 0 est le titre du déroulant
		  If i < 0 Or i > tokens.LastIndex Then Return
		  mProject.Settings.PackageName = mProject.Settings.PackageName + "$(" + tokens(i) + ")"
		  mUpdating = True
		  PackageNameField.Text = mProject.Settings.PackageName
		  mUpdating = False
		  Touch
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Shared Function TokenDescription(token As String) As String
		  Select Case token
		  Case "bundleName"
		    Return Loc.kTokBundleName
		  Case "bundleVerString"
		    Return Loc.kTokBundleVerString
		  Case "bundleVersion"
		    Return Loc.kTokBundleVersion
		  Case "bundleID"
		    Return Loc.kTokBundleID
		  Case "bundleArch"
		    Return Loc.kTokBundleArch
		  Case "minOS"
		    Return Loc.kTokMinOS
		  Case "dateYear"
		    Return Loc.kTokDateYear
		  Case "certDeveloperName"
		    Return Loc.kTokCertDeveloperName
		  Case "certTeamID"
		    Return Loc.kTokCertTeamID
		  End Select
		  Return token
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Touch()
		  If mUpdating Or mProject Is Nil Then Return
		  UpdateHints
		  If Owner <> Nil Then Owner.MarkDirty
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UpdateHints()
		  If mProject Is Nil Then Return
		  // Aperçu du nom résolu (texte dynamique et/ou nom compatible web).
		  If mProject.Settings.PackageName.IndexOf("$(") >= 0 Or mProject.Settings.WebSafeName Then
		    PreviewLabel.Text = Loc.kPreviewLabel + " " + PackageNaming.OutputName(mProject) + ".pkg"
		  Else
		    PreviewLabel.Text = ""
		  End If
		  
		  If mIdentities.Count = 0 Then
		    SigningHelp.Text = Loc.kNoInstallerIdentity
		  Else
		    SigningHelp.Text = Loc.kSignsWithProductbuild
		  End If
		  
		  // Aide au choix du certificat (identique à la version SwiftUI) : icône et teinte
		  // de l'encadré selon le certificat choisi.
		  Var id As String = mProject.Settings.SigningIdentity.Lowercase
		  If id.IndexOf("3rd party mac developer installer") >= 0 Then
		    CertTitle.Text = Loc.kMASCertificate
		    CertMessage.Text = Loc.kMASCertificateBody
		    mCertSymbol = "bag"
		    mCertTint = &cFF9F0A
		  ElseIf id.IndexOf("developer id installer") >= 0 Then
		    CertTitle.Text = Loc.kOutsideMAS
		    CertMessage.Text = Loc.kOutsideMASBody
		    mCertSymbol = "checkmark.seal"
		    mCertTint = &c30D158
		  ElseIf id = "" Then
		    CertTitle.Text = Loc.kWhichCertificate
		    CertMessage.Text = Loc.kWhichCertificateBody
		    mCertSymbol = "info.circle"
		    mCertTint = &c8E8E93
		  Else
		    CertTitle.Text = ""
		    CertMessage.Text = ""
		  End If
		  // Textes fixes : c'est la pose qui montre ou masque leurs lignes.
		  AppIdentityLabel.Enabled = True
		  HardenHelp.Text = Loc.kHardenHelp
		  HardenWarnLabel.Text = Loc.kNoAppIdentity
		  NotarizeHelp.Text = Loc.kNotaryProfileInPrefs
		  NotarizeWarnLabel.Text = Loc.kNotarizeNeedsSigned
		  LayoutAll
		End Sub
	#tag EndMethod


