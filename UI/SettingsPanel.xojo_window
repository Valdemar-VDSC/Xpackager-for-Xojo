#tag EndWindowCode

#tag Events InfoButton
	#tag Event
		Sub Pressed()
		  If mProject Is Nil Then Return
		  ShowTokenPopover
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events PackageNameField
	#tag Event
		Sub TextChanged()
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Settings.PackageName = Me.Text
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events WebSafeCheck
	#tag Event
		Sub ValueChanged(value As Boolean)
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Settings.WebSafeName = value
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events RefreshButton
	#tag Event
		Sub Pressed()
		  mIdentities = SigningIdentity.InstallerIdentities
		  mAppIdentities = SigningIdentity.ApplicationIdentities
		  Reload
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events HardenCheck
	#tag Event
		Sub ValueChanged(value As Boolean)
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Settings.HardenPayloadApps = value
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events NotarizeCheck
	#tag Event
		Sub ValueChanged(value As Boolean)
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Notarization.Enabled = value
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
