	#tag Method, Flags = &h21
		Private Sub ApplyTexts()
		  mUpdating = True
		  // ProductHeader.Text = Loc.kProduct
		  PackageNameLabel.Text = Loc.kPackageName
		  PackageNameField.Tooltip = Loc.kPackageNameHelp
		  InfoButton.Tooltip = Loc.kDynamicTokensHelp
		  If InfoButton.Inner <> Nil Then InfoButton.Inner.SetBordered(False)
		  WebSafeCheck.Caption = Loc.kWebSafeToggle
		  NameHelp.Text = Loc.kPerComponentNote
		  // SignatureHeader.Text = Loc.kSignatureOptional
		  SigningLabel.Text = Loc.kSigningIdentity
		  RefreshButton.Tooltip = Loc.kRefreshIdentities
		  If RefreshButton.Inner <> Nil Then RefreshButton.Inner.SetBordered(False)
		  // HardenHeader.Text = Loc.kHardeningSection
		  HardenCheck.Caption = Loc.kHardenToggle
		  AppIdentityLabel.Text = Loc.kAppIdentityLabel
		  HardenHelp.Text = Loc.kHardenHelp
		  // NotarizeHeader.Text = Loc.kNotarizationOptional
		  NotarizeCheck.Caption = Loc.kNotarizeAfterBuild
		  
		  TokenMenu.Caption = Loc.kInsertVariable
		  Var entries() As String
		  For Each token As String In PackageNaming.TokenNames
		    entries.Add("$(" + token + ") — " + TokenDescription(token))
		  Next
		  TokenMenu.Items = String.FromArray(entries, ";")
		  mUpdating = False
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub FillIdentityMenu(menu As DesktopPopupMenu, names() As String, current As String, emptyTitle As String)
		  menu.RemoveAllRows
		  menu.AddRow(emptyTitle)
		  menu.RowTagAt(0) = ""
		  Var selected As Integer = 0
		  For Each name As String In names
		    menu.AddRow(name)
		    menu.RowTagAt(menu.RowCount - 1) = name
		    If name = current Then selected = menu.RowCount - 1
		  Next
		  If current <> "" And selected = 0 Then
		    menu.AddRow(Loc.kUnavailable.ReplaceAll("%@", current))
		    menu.RowTagAt(menu.RowCount - 1) = current
		    selected = menu.RowCount - 1
		  End If
		  menu.SelectedRowIndex = selected
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub LoadProject(p As PackageProject)
		  mProject = p
		  mIdentities = SigningIdentity.InstallerIdentities
		  mAppIdentities = SigningIdentity.ApplicationIdentities
		  ApplyTexts
		  Reload
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub Reload()
		  If mProject Is Nil Then Return
		  mUpdating = True
		  PackageNameField.Text = mProject.Settings.PackageName
		  WebSafeCheck.Value = mProject.Settings.WebSafeName
		  HardenCheck.Value = mProject.Settings.HardenPayloadApps
		  NotarizeCheck.Value = mProject.Notarization.Enabled
		  FillIdentityMenu(SigningPopup, mIdentities, mProject.Settings.SigningIdentity, Loc.kUnsigned)
		  FillIdentityMenu(AppIdentityPopup, mAppIdentities, mProject.Settings.AppSigningIdentity, Loc.kChooseEllipsis)
		  mUpdating = False
		  UpdateHints
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub ShowTokenPopover()
		  // Liste des variables de texte dynamique, dans un NSPopover natif.
		  Var body() As String
		  body.Add(Loc.kSupportedDynamicText)
		  body.Add("")
		  For Each token As String In PackageNaming.TokenNames
		    body.Add("$(" + token + ")" + "   " + TokenDescription(token))
		  Next
		  body.Add("")
		  body.Add(Loc.kTokenValuesSource)
		  
		  mTokenText = New NativeTextView(380, 240)
		  mTokenText.Text = String.FromArray(body, EndOfLine)
		  mTokenText.SetEditable(False, False)
		  mTokenText.SetBorder(NativeTextView.Borders.None)
		  mTokenPopover = New NativePopover(400, 260)
		  mTokenPopover.AddView(mTokenText.Handle, 10, 10, 380, 240)
		  mTokenPopover.Show(InfoButton)
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Shared Function TokenDescription(token As String) As String
		  Select Case token
		  Case "bundleName"
		    Return Loc.kTokBundleName
		  Case "bundleVerString"
		    Return Loc.kTokBundleVerString
		  Case "bundleVersion"
		    Return Loc.kTokBundleVersion
		  Case "bundleID"
		    Return Loc.kTokBundleID
		  Case "bundleArch"
		    Return Loc.kTokBundleArch
		  Case "minOS"
		    Return Loc.kTokMinOS
		  Case "dateYear"
		    Return Loc.kTokDateYear
		  Case "certDeveloperName"
		    Return Loc.kTokCertDeveloperName
		  Case "certTeamID"
		    Return Loc.kTokCertTeamID
		  End Select
		  Return token
		End Function
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub Touch()
		  If mUpdating Or mProject Is Nil Then Return
		  UpdateHints
		  If Owner <> Nil Then Owner.MarkDirty
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h21
		Private Sub UpdateHints()
		  If mProject Is Nil Then Return
		  // Aperçu du nom résolu (texte dynamique et/ou nom compatible web).
		  If mProject.Settings.PackageName.IndexOf("$(") >= 0 Or mProject.Settings.WebSafeName Then
		    PreviewLabel.Text = Loc.kPreviewLabel + " " + PackageNaming.OutputName(mProject) + ".pkg"
		  Else
		    PreviewLabel.Text = ""
		  End If
		  
		  If mIdentities.Count = 0 Then
		    SigningHelp.Text = Loc.kNoInstallerIdentity
		  Else
		    SigningHelp.Text = Loc.kSignsWithProductbuild
		  End If
		  
		  // Aide au choix du certificat (identique à la version SwiftUI).
		  Var id As String = mProject.Settings.SigningIdentity.Lowercase
		  If id.IndexOf("3rd party mac developer installer") >= 0 Then
		    CertTitle.Text = Loc.kMASCertificate
		    CertMessage.Text = Loc.kMASCertificateBody
		  ElseIf id.IndexOf("developer id installer") >= 0 Then
		    CertTitle.Text = Loc.kOutsideMAS
		    CertMessage.Text = Loc.kOutsideMASBody
		  ElseIf id = "" Then
		    CertTitle.Text = Loc.kWhichCertificate
		    CertMessage.Text = Loc.kWhichCertificateBody
		  Else
		    CertTitle.Text = ""
		    CertMessage.Text = ""
		  End If
		  
		  AppIdentityLabel.Enabled = mProject.Settings.HardenPayloadApps
		  AppIdentityPopup.Enabled = mProject.Settings.HardenPayloadApps
		  If mProject.Settings.HardenPayloadApps And mAppIdentities.Count = 0 Then
		    HardenHelp.Text = Loc.kNoAppIdentity
		  Else
		    HardenHelp.Text = Loc.kHardenHelp
		  End If
		  
		  If Not mProject.Notarization.Enabled Then
		    NotarizeHelp.Text = ""
		  ElseIf mProject.Settings.SigningIdentity.Trim = "" Then
		    NotarizeHelp.Text = Loc.kNotarizeNeedsSigned
		  Else
		    NotarizeHelp.Text = Loc.kNotaryProfileInPrefs
		  End If
		End Sub
	#tag EndMethod


	#tag Property, Flags = &h21
		Private mAppIdentities() As String
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mIdentities() As String
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mProject As PackageProject
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mTokenPopover As NativePopover
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mTokenText As NativeTextView
	#tag EndProperty

	#tag Property, Flags = &h21
		Private mUpdating As Boolean
	#tag EndProperty

	#tag Property, Flags = &h0
		Owner As ProjectWindow
	#tag EndProperty


#tag EndWindowCode

#tag Events InfoButton
	#tag Event
		Sub Pressed()
		  If mProject Is Nil Then Return
		  ShowTokenPopover
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events TokenMenu
	#tag Event
		Sub MenuItemSelected(index As Integer, title As String)
		  #Pragma Unused title
		  If mUpdating Or mProject Is Nil Then Return
		  Var tokens() As String = PackageNaming.TokenNames
		  If index < 0 Or index > tokens.LastIndex Then Return
		  mProject.Settings.PackageName = mProject.Settings.PackageName + "$(" + tokens(index) + ")"
		  mUpdating = True
		  PackageNameField.Text = mProject.Settings.PackageName
		  mUpdating = False
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events PackageNameField
	#tag Event
		Sub TextChanged()
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Settings.PackageName = Me.Text
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events WebSafeCheck
	#tag Event
		Sub ValueChanged()
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Settings.WebSafeName = Me.Value
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events RefreshButton
	#tag Event
		Sub Pressed()
		  mIdentities = SigningIdentity.InstallerIdentities
		  mAppIdentities = SigningIdentity.ApplicationIdentities
		  Reload
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events SigningPopup
	#tag Event
		Sub SelectionChanged(item As DesktopMenuItem)
		  If mUpdating Or mProject Is Nil Then Return
		  If Me.SelectedRowIndex < 0 Then Return
		  mProject.Settings.SigningIdentity = Me.RowTagAt(Me.SelectedRowIndex)
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events AppIdentityPopup
	#tag Event
		Sub SelectionChanged(item As DesktopMenuItem)
		  If mUpdating Or mProject Is Nil Then Return
		  If Me.SelectedRowIndex < 0 Then Return
		  mProject.Settings.AppSigningIdentity = Me.RowTagAt(Me.SelectedRowIndex)
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events HardenCheck
	#tag Event
		Sub ValueChanged()
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Settings.HardenPayloadApps = Me.Value
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events NotarizeCheck
	#tag Event
		Sub ValueChanged()
		  If mUpdating Or mProject Is Nil Then Return
		  mProject.Notarization.Enabled = Me.Value
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
