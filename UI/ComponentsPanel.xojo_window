		  If mUpdating Or mProject Is Nil Then Return
		  Var comp As PkgComponent = Current
		  If comp Is Nil Then Return
		  comp.Name = Me.Text
		  ReloadComponentMenu
		  Touch
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events PreField
	#tag Event
		Sub TextChanged()
		  If mUpdating Or mProject Is Nil Then Return
		  Var comp As PkgComponent = Current
